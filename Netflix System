import java.util.ArrayList;
import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        ArrayList<String> movies = new ArrayList<>();
        while (true) {
            System.out.println("\n--- NETFLIX CRUD ---");
            System.out.println("1. Add Movie");
            System.out.println("2. View Movies");
            System.out.println("3. Update Movie");
            System.out.println("4. Delete Movie");
            System.out.println("5. Exit");
            System.out.print("Enter Choice: ");
            int choice = sc.nextInt();
            sc.nextLine();
            switch (choice) {
                case 1: 
                    System.out.print("Enter Movie Name: ");
                    String movie = sc.nextLine();
                    movies.add(movie);
                    System.out.println("Movie Added Successfully!");
                    break;
                case 2:
                    System.out.println("\nAvailable Movies:");
                    for (int i = 0; i < movies.size(); i++) {
                        System.out.println(i + " : " + movies.get(i));
                    }
                    break;
                case 3: 
                    System.out.print("Enter Movie Index to Update: ");
                    int updateIndex = sc.nextInt();
                    sc.nextLine();
                    System.out.print("Enter New Movie Name: ");
                    String newMovie = sc.nextLine();
                    movies.set(updateIndex, newMovie);
                    System.out.println("Movie Updated Successfully!");
                    break;
                case 4:
                    System.out.print("Enter Movie Index to Delete: ");
                    int deleteIndex = sc.nextInt();
                    movies.remove(deleteIndex);
                    System.out.println("Movie Deleted Successfully!");
                    break;
                case 5: 
                    System.out.println("Thank You!");
                    sc.close();
                    System.exit(0);
                default:
                    System.out.println("Invalid Choice!");
            }
        }
    }
}
