import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int[][] matrix = new int[3][3];
        System.out.println("Enter 0s and 1s for a 3x3 matrix:");
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                matrix[i][j] = sc.nextInt();
            }
        }
        boolean valid = true;
        for (int i = 0; i < 3; i++) {
            int rowSum = 0;
            for (int j = 0; j < 3; j++) {
                rowSum += matrix[i][j];
            }
            if (rowSum != 1) {
                valid = false;
            }
        }
        for (int j = 0; j < 3; j++) {
            int colSum = 0;
            for (int i = 0; i < 3; i++) {
                colSum += matrix[i][j];
            }
            if (colSum != 1) {
                valid = false;
            }
        }
        if (valid) {
            System.out.println("Valid Sudoku-style 0-1 Matrix");
        } else {
            System.out.println("Invalid Matrix");
        }

        sc.close();
    }
}
